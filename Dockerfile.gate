# The login gate (server/finder/gate.py): a small public server in front of the app.
FROM python:3.12-slim
ENV PYTHONPATH=/app/server PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir starlette==1.10.0 uvicorn==0.54.0 httpx==0.28.1 python-dotenv==1.2.4
WORKDIR /app
COPY server/finder ./server/finder
COPY web/public/icon.svg ./web/public/icon.svg
EXPOSE 8080
CMD ["python", "-m", "finder.gate"]
