# Settings for the item finder. The easiest way to fill these in is the app itself:
# Settings -> AI provider and Settings -> API keys write to this file for you.
# A value here wins over the same variable in your shell environment.

# --- AI provider (optional, but most features need it) ---------------------------
# Any OpenAI-compatible chat API works. Pick a preset with LLM_PROVIDER, or set
# LLM_BASE_URL yourself. The model should read photos (vision) for photo checks.
#
#   LLM_PROVIDER   base URL (filled in for you)                        example model
#   openai         https://api.openai.com/v1                           gpt-5-mini
#   gemini         https://generativelanguage.googleapis.com/v1beta/openai   gemini-flash-latest  (free tier)
#   anthropic      https://api.anthropic.com/v1                        claude-haiku-5-5
#   openrouter     https://openrouter.ai/api/v1                        google/gemini-2.5-flash
#   ollama         http://localhost:11434/v1                           qwen2.5vl:7b  (free, local, no key)
#   lmstudio       http://localhost:1234/v1                            (the model you loaded)
#   deepseek       https://api.deepseek.com/v1                         deepseek-chat  (no photos)
#   custom         set LLM_BASE_URL (LiteLLM, vLLM, Groq, Together, Azure, CLIProxyAPI...)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# auto: send photos to the AI until the model refuses them. off: never send photos.
# LLM_VISION=auto
# Multiply AI timeouts, for example 3 for a slow local model.
# LLM_TIMEOUT=1

# --- Optional service keys --------------------------------------------------------
# Google Images, Lens and site: search (2,500 free searches): https://serper.dev
SERPER_API_KEY=
# The same searches, used when Serper fails (250 free a month): https://serpapi.com
SERPAPI_API_KEY=
# 1688 photo search, about $0.015 a search from Apify's $5 monthly credit: https://apify.com
APIFY_TOKEN=
# Extra listings with QC photos (free plan): https://qualit.ly
QUALITLY_API_KEY=

# --- Server and browser -------------------------------------------------------------
# FINDER_PORT=8790
# The app has no login. Keep FINDER_HOST=127.0.0.1 unless you know what you are doing.
# FINDER_HOST=127.0.0.1
# FINDER_ALLOWED_HOSTS=finder.example.com
# Password for access from other devices (a tunnel, a proxy, a server). 127.0.0.1 stays open
# unless FINDER_AUTH=all.
# FINDER_PASSWORD=
# FINDER_AUTH=remote
# Search browser: minimized (default), visible, or hidden (headless; Taobao blocks it).
# BROWSER_MODE=minimized
# Image model for ranking (open_clip name).
# EMBED_MODEL=hf-hub:Marqo/marqo-ecommerce-embeddings-B
